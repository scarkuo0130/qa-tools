{
  "compilerOptions": {
    "target": "ES2015",
    "module": "ESNext",
    "outDir": "./js_compiled",
    "rootDir": "./ts", 
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "moduleResolution": "node" 
  },
  "include": [
    "ts/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
} 